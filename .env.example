# Environment Configuration for VaaniAI
PORT=5000
FLASK_DEBUG=True

# MongoDB Connection (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017
DB_NAME=vaaniai

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (configurable)
GEMINI_MODEL=gemini-2.5-flash

# DEMO_MODE: When true or when Gemini is unreachable, realistic pre-computed
# Paninian phonetics responses are returned for live exhibitions so the demo never fails.
DEMO_MODE=true
